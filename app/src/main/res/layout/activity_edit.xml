<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <!-- Toolbar-строка -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="8dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:tint="@color/onSurface"
            android:contentDescription="@string/cancel" />

        <TextView
            android:id="@+id/txtName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:textColor="@color/onSurface"
            android:textSize="15sp"
            android:singleLine="true"
            android:ellipsize="middle"
            android:text="@string/clip" />

        <ImageButton
            android:id="@+id/btnUndo"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_revert"
            android:tint="@color/onSurface"
            android:contentDescription="@string/undo" />

        <ImageButton
            android:id="@+id/btnRedo"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_rotate"
            android:tint="@color/onSurface"
            android:contentDescription="@string/redo" />

        <ImageButton
            android:id="@+id/btnSave"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_save"
            android:tint="@color/accent"
            android:contentDescription="@string/save" />

        <ImageButton
            android:id="@+id/btnInfo"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_info_details"
            android:tint="@color/onSurface"
            android:contentDescription="Инфо" />

        <ImageButton
            android:id="@+id/btnExport"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_share"
            android:tint="@color/accent"
            android:contentDescription="@string/export" />
    </LinearLayout>

    <!-- Волна -->
    <com.grinya.voicesampleprep.edit.WaveformView
        android:id="@+id/wave"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Транспорт -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="8dp"
        android:background="@color/surface">

        <ImageButton
            android:id="@+id/btnPlay"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_media_play"
            android:tint="@color/accent"
            android:contentDescription="Play" />

        <ImageButton
            android:id="@+id/btnPause"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_media_pause"
            android:tint="@color/onSurface"
            android:contentDescription="Pause" />

        <ImageButton
            android:id="@+id/btnStop"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:tint="@color/onSurface"
            android:contentDescription="@string/stop" />

        <TextView
            android:id="@+id/txtTime"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/onSurface"
            android:textSize="14sp"
            android:gravity="center"
            android:fontFamily="monospace"
            android:text="00:00.000 / 00:00.000" />

        <Button
            android:id="@+id/btnZoomOut"
            style="?android:attr/buttonStyleSmall"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:text="−"
            android:textSize="20sp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:textColor="@color/onSurface"
            android:contentDescription="zoom out" />

        <Button
            android:id="@+id/btnZoomIn"
            style="?android:attr/buttonStyleSmall"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:text="+"
            android:textSize="20sp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:textColor="@color/accent"
            android:contentDescription="zoom in" />

        <Button
            android:id="@+id/btnMarker"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:text="M"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/bg"
            android:backgroundTint="@color/accent"
            android:contentDescription="Marker" />
    </LinearLayout>

    <!-- Панель инструментов (горизонтальный скролл) -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="6dp">

            <Button
                android:id="@+id/btnTrim"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/trim" />

            <Button
                android:id="@+id/btnCut"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cut" />

            <Button
                android:id="@+id/btnInsert"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/insert" />

            <Button
                android:id="@+id/btnSilence"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/silence" />

            <Button
                android:id="@+id/btnGain"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/gain" />

            <Button
                android:id="@+id/btnNormalize"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/normalize" />

            <Button
                android:id="@+id/btnDenoise"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/denoise" />

            <Button
                android:id="@+id/btnFadeIn"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/fade_in" />

            <Button
                android:id="@+id/btnFadeOut"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/fade_out" />

            <Button
                android:id="@+id/btnReverse"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/reverse" />

            <Button
                android:id="@+id/btnInvert"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/invert" />

        </LinearLayout>
    </HorizontalScrollView>
</LinearLayout>
