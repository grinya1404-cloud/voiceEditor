<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <!-- Контейнер для волны и плавающих кнопок -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">


        <!-- Волна (внутри контейнера) -->
        <com.grinya.voicesampleprep.edit.WaveformView
            android:id="@+id/wave"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />


        <!-- Имя файла (слева вверху) -->
        <TextView
            android:id="@+id/txtName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_marginTop="16dp"
            android:layout_marginStart="16dp"
            android:background="#AA1A1A1E"
            android:padding="4dp"
            android:maxWidth="200dp"
            android:singleLine="true"
            android:ellipsize="middle"
            android:textColor="@color/onSurface"
            android:textSize="14sp"
            android:text="clip" />

        <!-- Панель кнопок (справа вверху) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            android:orientation="horizontal"
            android:background="#AA1A1A1E"
            android:padding="4dp"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:tint="@color/onSurface" />

            <ImageButton
                android:id="@+id/btnUndo"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_revert"
                android:tint="@color/onSurface" />

            <ImageButton
                android:id="@+id/btnRedo"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_rotate"
                android:tint="@color/onSurface" />

            <ImageButton
                android:id="@+id/btnMenu"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_more"
                android:tint="@color/accent" />
        </LinearLayout>


        <!-- Плавающие кнопки справа внизу (Зум и Маркер) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginBottom="16dp"
            android:layout_marginEnd="16dp"
            android:orientation="vertical"
            android:gravity="center">

            <Button
                android:id="@+id/btnZoomIn"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginBottom="8dp"
                android:text="+"
                android:textSize="20sp"
                android:textColor="@color/accent"
                android:backgroundTint="#AA1A1A1E" />

            <Button
                android:id="@+id/btnZoomOut"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginBottom="8dp"
                android:text="−"
                android:textSize="20sp"
                android:textColor="@color/accent"
                android:backgroundTint="#AA1A1A1E" />

            <Button
                android:id="@+id/btnMarker"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text="M"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/bg"
                android:backgroundTint="#AAFFB300" />
        </LinearLayout>

        <!-- Плавающая панель плеера слева внизу -->

        <!-- Панель плеера (слева внизу) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_marginBottom="16dp"
            android:layout_marginStart="16dp"
            android:orientation="vertical"
            android:gravity="start">

            <!-- Кнопки плеера -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="4dp">

                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/btnPlay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:src="@android:drawable/ic_media_play"
                    app:backgroundTint="@color/accent"
                    app:tint="@color/bg"
                    app:elevation="4dp" />

                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/btnStop"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    app:backgroundTint="#AA1A1A1E"
                    app:tint="@color/onSurface"
                    app:elevation="4dp" />
            </LinearLayout>

            <!-- Таймер (под кнопками) -->
            <TextView
                android:id="@+id/txtTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/onSurface"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:background="#AA1A1A1E"
                android:padding="4dp"
                android:text="00:00.000 / 00:00.000" />
        </LinearLayout>

    </FrameLayout>

    <!-- Панель инструментов (горизонтальный скролл) -->
    <!-- Панель инструментов (горизонтальный скролл) -->
<!-- Панель инструментов (растянута на всю ширину) -->
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@color/surface"
    android:padding="6dp"
    android:gravity="center_vertical">

    <TextView
        android:id="@+id/btnTrim"
        style="@style/AmberButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginEnd="4dp"
        android:text="@string/trim" />

    <TextView
        android:id="@+id/btnCut"
        style="@style/AmberButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginEnd="4dp"
        android:text="@string/cut" />

    <TextView
        android:id="@+id/btnCopy"
        style="@style/AmberButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginEnd="4dp"
        android:text="@string/copy" />

    <TextView
        android:id="@+id/btnPaste"
        style="@style/AmberButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginEnd="4dp"
        android:text="@string/paste" />

    <TextView
        android:id="@+id/btnDynamic1"
        style="@style/AmberButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginEnd="4dp"
        android:visibility="gone"
        android:text="" />

    <TextView
        android:id="@+id/btnDynamic2"
        style="@style/AmberButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginEnd="4dp"
        android:visibility="gone"
        android:text="" />

    <TextView
        android:id="@+id/btnMore"
        style="@style/AmberButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="⋮" />
</LinearLayout>
</LinearLayout>
